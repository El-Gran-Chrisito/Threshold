# Copy to .env.local (not committed) or set these in your host's build settings.
# See docs/MONETIZATION.md.

# Public half of the license signing key, from `bun run license init`.
VITE_LICENSE_PUBLIC_KEY=
# Your deployed license server, e.g. https://threshold-license.<you>.workers.dev
VITE_LICENSE_API=
# Hosted checkout links (Stripe Payment Links work as-is).
VITE_CHECKOUT_PRO_MONTHLY=
VITE_CHECKOUT_PRO_YEARLY=
VITE_CHECKOUT_STUDIO_MONTHLY=
VITE_CHECKOUT_STUDIO_YEARLY=
VITE_CHECKOUT_PRO_PASS=
# Shown in the upgrade sheet and site footer.
VITE_SUPPORT_EMAIL=
# Your site address, e.g. https://threshold.example. Used for link previews,
# search data (prices, FAQ), the sitemap and robots.txt.
VITE_SITE_URL=
# Stripe customer portal login link, for "Manage subscription".
VITE_BILLING_PORTAL_URL=
# Shopping list "Find it" links: a store search with {q} for the words.
# Default: Google Shopping. Use your affiliate search link to earn a commission,
# e.g. https://www.amazon.com/s?k={q}&tag=yourtag-20
VITE_SHOP_URL=
# Optional per-group links as JSON, e.g. {"Paint":"https://...{q}","Furniture & fixtures":"https://...{q}"}
VITE_SHOP_URLS=
# Invites: a Stripe promotion code for invited friends, and the offer in words
# (shown to both people, so keep it neutral), e.g. FRIEND20 and "20% off the first payment".
VITE_INVITE_PROMO_CODE=
VITE_INVITE_OFFER=
# Where the landing page links to the app. Use /app when the host rewrites are active.
VITE_APP_PATH=/app
